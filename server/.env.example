PORT=4000
# Supabase: Project Settings -> Database -> Connection string (append ?sslmode=require)
# Railway: the DATABASE_URL variable from the Postgres plugin
DATABASE_URL=postgres://postgres:postgres@localhost:5432/linentag
# Long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
# Comma-separated OAuth client IDs (iOS, Android, Web) whose Google ID tokens are accepted
GOOGLE_CLIENT_IDS=
