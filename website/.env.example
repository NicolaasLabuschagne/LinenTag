# Public URL of this website (canonical links, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://linentag.app
# LinenTag API (server/). Waitlist sign-ups are stored there. Server-side only.
LINENTAG_API_URL=http://localhost:4000
# Optional: where contact-form messages are POSTed as JSON (e.g. a Slack/Zapier/Make webhook).
CONTACT_WEBHOOK_URL=
# Optional analytics, loaded only after the visitor accepts cookies. Plausible domain, e.g. linentag.app
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
