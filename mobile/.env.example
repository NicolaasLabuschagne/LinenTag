# Base URL of the LinenTag API. On a physical device use your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# Google Cloud OAuth "Web application" client ID (used to mint ID tokens the API verifies)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Google Cloud OAuth iOS client ID, and its reversed form used as the iOS URL scheme
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_URL_SCHEME=
# Website with the label maker for bedding without tags. Defaults to EXPO_PUBLIC_API_URL (the API serves it).
EXPO_PUBLIC_WEB_URL=
